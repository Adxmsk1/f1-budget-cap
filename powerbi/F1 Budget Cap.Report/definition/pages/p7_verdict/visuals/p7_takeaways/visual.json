    "visual":  {
                   "visualType":  "textbox",
                   "objects":  {
                                   "general":  [
                                                   {
                                                       "properties":  {
                                                                          "paragraphs":  [
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Dominance became temporary",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E10600",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Mercedes won eight constructors\u0027 titles in a row (2014-2021). Since then the title has passed between Red Bull, McLaren and Mercedes. But the cap has not made dominance impossible: Red Bull\u0027s 2023 title, won by 451 points, was the most one-sided season of all.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "The cars got closer",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E10600",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "The clearest effect is on raw speed. The slowest team\u0027s qualifying deficit shrank by about a third. The 2022 rule overhaul pushed the same way, so the cap cannot take all the credit.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Money no longer buys the best crew",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E10600",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Before the cap the champion had a top-two pit crew in six of seven seasons. Under the cap, half the titles were won with only the third- or fourth-best crew - operational excellence is more evenly spread.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "The rewards have not spread out",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E10600",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "The top three teams still take around 70% of all points, and the back of the grid scores almost nothing, because points only go to the top ten finishers.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "So, did it work?",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "11pt",
                                                                                                                                        "color":  "#E10600",
                                                                                                                                        "fontWeight":  "bold"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "Partly. The cap has made F1 less predictable at the front and closer on pace, but not yet fairer for the teams at the back. Six seasons is a short record, and 2026 is incomplete and brings new rules - these are trends worth re-checking as more seasons arrive.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "9.5pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  " ",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontFamily":  "Segoe UI",
                                                                                                                                        "fontSize":  "4pt",
                                                                                                                                        "color":  "#15151E"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             }
                                                                                         ]
                                                                      }
                                                   }
                                               ]
                               },
