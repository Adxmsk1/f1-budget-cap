table fact_results
	lineageTag: 30d84e06-0de1-4514-ad12-043d01062238

	measure 'Winning Teams' = CALCULATE(DISTINCTCOUNT(fact_results[constructor_id]), fact_results[position_order] = 1, REMOVEFILTERS(dim_constructor))
		formatString: 0
		lineageTag: dd33be70-b9cd-4219-9d55-c7d052728f1f

	measure 'Avg Winning Teams' = AVERAGEX(VALUES(dim_season[season]), [Winning Teams])
		formatString: 0.0
		lineageTag: 4be06814-ea2c-46d5-82bc-9660f19a1723

	measure 'Seasons With 4+ Winners' = 0 + COUNTROWS(FILTER(VALUES(dim_season[season]), [Winning Teams] >= 4))
		formatString: 0
		lineageTag: 17adcfa2-8173-40df-afb2-dde135fba49d

	measure 'Pre-Cap Avg Winning Teams' = CALCULATE([Avg Winning Teams], dim_season[is_post_cap] = FALSE())
		formatString: 0.0
		lineageTag: 3ac058f5-fe81-48b8-9860-01148606b67b

	measure 'Post-Cap Avg Winning Teams' = CALCULATE([Avg Winning Teams], dim_season[is_post_cap] = TRUE())
		formatString: 0.0
		lineageTag: 40aa64d9-5516-4fc2-bb4b-8ff4a68dbe02

	measure 'Total Race Entries' = COUNTROWS(fact_results)
		formatString: #,0
		lineageTag: c9d88ec4-2262-4d64-b75e-045fa9b638b4

	measure 'Total Points' = SUM(fact_results[points])
		formatString: #,0
		lineageTag: 446e04eb-9eb3-4305-81a2-5d2c3b982089

	measure 'Avg Places Gained' = AVERAGE(fact_results[places_gained])
		formatString: 0.0
		lineageTag: 18f2508c-ff1c-46fd-a34a-f9180bc2cc5d

	measure 'Avg Grid Position' = AVERAGE(fact_results[grid])
		formatString: 0.0
		lineageTag: c8c54b7f-21c0-4e28-a802-c31ded1f44db

	measure 'Avg Finish Position' = AVERAGE(fact_results[position_order])
		formatString: 0.0
		lineageTag: 2718b332-bd0a-4846-a1af-87c9d6f3899e

	measure 'Distinct Race Winners' = CALCULATE(DISTINCTCOUNT(fact_results[driver_id]), fact_results[position_order] = 1)
		formatString: #,0
		lineageTag: 07cc8100-24c6-4219-a806-66026b3caecc

